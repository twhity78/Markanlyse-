# Vorlage für den Passwortschutz.
#
# Lokal:  Diese Datei nach  .streamlit/secrets.toml  kopieren und ein
#         Passwort eintragen. (secrets.toml wird NICHT versioniert.)
#
# Cloud:  In Streamlit Community Cloud unter
#         "Manage app" -> "Settings" -> "Secrets" denselben Inhalt einfügen.
#
# Alternativ kann statt secrets.toml die Umgebungsvariable
# NK_APP_PASSWORD gesetzt werden.

app_password = "bitte-hier-ein-sicheres-passwort-eintragen"
