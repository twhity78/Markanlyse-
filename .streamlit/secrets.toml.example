# Vorlage für die geteilte Cloud-Datenbank und den Passwortschutz.
#
# Lokal:  Diese Datei nach  .streamlit/secrets.toml  kopieren und ausfüllen.
#         (secrets.toml wird NICHT versioniert, siehe .gitignore.)
#
# Cloud:  In Streamlit Community Cloud unter
#         "Manage app" -> "Settings" -> "Secrets" denselben Inhalt einfügen.

# Passwortschutz der App (siehe README, Abschnitt "Passwortschutz").
app_password = "bitte-hier-ein-sicheres-passwort-eintragen"

# Geteilte Datenbank (Supabase/Postgres), damit beide Parteien jederzeit
# dieselben Zählerstände, Belege und Fotos sehen – auch nach einem Neustart
# der App. Ohne diese Zeile läuft die App mit einer lokalen SQLite-Datei
# (nicht geteilt, nicht dauerhaft in der Cloud). Die Verbindungszeichenfolge
# gibt es im Supabase-Projekt unter "Project Settings" -> "Database" ->
# "Connection string" -> "URI" (den "Transaction pooler"-Connection-String
# verwenden, Port 6543 oder 5432, je nach Supabase-Projekt).
DATABASE_URL = "postgresql://postgres:DEIN-PASSWORT@db.DEIN-PROJEKT.supabase.co:5432/postgres"
