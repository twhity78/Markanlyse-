# Anthropic API Key - hol dir einen auf https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Trading Modus: paper (sicher, kein echtes Geld) oder live
TRADING_MODE=paper

# Standard-Asset für den Agenten
DEFAULT_SYMBOL=AAPL

# Startkapital für Paper Trading (in USD)
PAPER_BALANCE=10000
